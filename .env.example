# ==============================================================================
# Environment Configuration Template for CCARC Road Damage Research
# Copy this file to .env and adjust variables to match your local setup.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Project & Path Settings
PROJECT_NAME="CCARC-Road-Damage-Research"
DATASET_DIR="d:/Datasets/RDD2022"
CHECKPOINTS_DIR="./checkpoints"
EXPERIMENTS_DIR="./experiments"

# Compute & Hardware Configuration
# DEVICE options: "cuda", "cpu", or specific GPU index "cuda:0"
DEVICE="cuda"
NUM_WORKERS=4
SEED=42

# Logging & Experiment Tracking (Optional)
WANDB_API_KEY=""
WANDB_PROJECT="ccarc-road-damage"
WANDB_MODE="offline" # "online" or "offline"

# Streamlit App Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
